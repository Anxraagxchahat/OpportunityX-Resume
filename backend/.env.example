# Application Config
APP_NAME="OpportunityX Resume Backend"
APP_ENV=development
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://resume.opportunityx.co.in","https://opportunityx.co.in"]

# Database Config (PostgreSQL / Supabase Pooler)
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/opportunityx_resume
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key

# Central OpportunityX Firebase Config (Service Account)
FIREBASE_PROJECT_ID=opportunityx-61efd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@opportunityx-61efd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"

# Cashfree Payment Gateway Credentials
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=SANDBOX # SANDBOX or PRODUCTION
CASHFREE_API_VERSION=2023-08-01

# AI Infrastructure Config (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key
DEFAULT_AI_MODEL=openrouter/auto
