# OpportunityX Resume — Frontend Environment Configuration
# Copy this file to .env.local and fill in your credentials.

# Central OpportunityX Firebase Configuration (Web Client)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=auth.opportunityx.co.in
VITE_FIREBASE_PROJECT_ID=opportunityx-61efd
VITE_FIREBASE_STORAGE_BUCKET=opportunityx-61efd.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# App & Backend Gateway URLs
VITE_APP_TITLE=OpportunityX Resume Engine
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8001/api/v1
