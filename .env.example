# OpportunityX Resume — Firebase Configuration
# Copy this file to .env.local and fill in your Firebase credentials
# These credentials must point to the central OpportunityX Firebase project

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=auth.opportunityx.co.in
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
