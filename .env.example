# OpportunityX Resume — Frontend Environment Configuration
# Copy this file to .env.local and fill in your credentials.

# Central OpportunityX Firebase Configuration (Required for Firebase Auth)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project_id_here.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Optional AI Infrastructure (OpenRouter)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_APP_TITLE=OpportunityX Resume Engine
VITE_APP_URL=http://localhost:5173
